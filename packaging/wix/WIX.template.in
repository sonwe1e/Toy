<?xml version="1.0" encoding="UTF-8"?>

<?include "cpack_variables.wxi"?>

<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"@CPACK_WIX_CUSTOM_XMLNS_EXPANDED@
    RequiredVersion="4.0"
    >

    <Package
        Name="$(var.CPACK_PACKAGE_NAME)"
        Version="$(var.CPACK_PACKAGE_VERSION)"
        Manufacturer="$(var.CPACK_PACKAGE_VENDOR)"
        UpgradeCode="$(var.CPACK_WIX_UPGRADE_GUID)"
        ProductCode="$(var.CPACK_WIX_PRODUCT_GUID)"
        Scope="$(var.CPACK_WIX_INSTALL_SCOPE)"
        InstallerVersion="500"
        Language="1033"
        Compressed="yes"
        >

        <?ifndef CPACK_WIX_CAB_PER_COMPONENT?>
        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes"/>
        <?endif?>

        <MajorUpgrade
            Schedule="afterInstallInitialize"
            AllowSameVersionUpgrades="no"
            DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit."/>

        <WixVariable Id="WixUILicenseRtf" Value="$(var.CPACK_WIX_LICENSE_RTF)"/>
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALL_ROOT"/>

        <?ifdef CPACK_WIX_PRODUCT_ICON?>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />
        <Icon Id="ProductIcon.ico" SourceFile="$(var.CPACK_WIX_PRODUCT_ICON)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_BANNER?>
        <WixVariable Id="WixUIBannerBmp" Value="$(var.CPACK_WIX_UI_BANNER)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_DIALOG?>
        <WixVariable Id="WixUIDialogBmp" Value="$(var.CPACK_WIX_UI_DIALOG)"/>
        <?endif?>

        <DirectoryRef Id="INSTALL_ROOT">
            <Component
                Id="VCStationProjectAssociation"
                Guid="1C0E89D8-18D6-4C29-87E5-D67A4205E0B9">
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\.dvsproj"
                    Value="VCStation.Project"
                    Type="string"
                    KeyPath="yes"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\.dvsproj"
                    Name="Content Type"
                    Value="application/x-vcstation-project"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\VCStation.Project"
                    Value="VCStation review project"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\VCStation.Project\DefaultIcon"
                    Value="&quot;[INSTALL_ROOT]VCStation.exe&quot;,0"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\VCStation.Project\shell\open\command"
                    Value="&quot;[INSTALL_ROOT]VCStation.exe&quot; &quot;%1&quot;"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\Applications\VCStation.exe\SupportedTypes"
                    Name=".dvsproj"
                    Value=""
                    Type="string"/>
            </Component>
        </DirectoryRef>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="VCStationProgramMenuFolder" Name="VCStation">
                <Component
                    Id="VCStationStartMenuShortcut"
                    Guid="6DD95669-3B96-4888-B35D-0C3F7F777AD5">
                    <Shortcut
                        Id="VCStationStartMenuEntry"
                        Name="VCStation"
                        Description="VCStation - VideoCompareStation"
                        Target="[INSTALL_ROOT]VCStation.exe"
                        WorkingDirectory="INSTALL_ROOT"/>
                    <RemoveFolder
                        Id="RemoveVCStationProgramMenuFolder"
                        Directory="VCStationProgramMenuFolder"
                        On="uninstall"/>
                    <RegistryValue
                        Root="HKCU"
                        Key="Software\VCStation"
                        Name="StartMenuShortcut"
                        Value="1"
                        Type="integer"
                        KeyPath="yes"/>
                </Component>
            </Directory>
        </StandardDirectory>

        <FeatureRef Id="ProductFeature">
            <ComponentRef Id="VCStationProjectAssociation"/>
            <ComponentRef Id="VCStationStartMenuShortcut"/>
        </FeatureRef>

        <ui:WixUI Id="$(var.CPACK_WIX_UI_REF)" />
        <UIRef Id="WixUI_ErrorProgressText" />

        <?include "properties.wxi"?>
        <?include "product_fragment.wxi"?>
    </Package>
</Wix>
