{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "dual-video-studio",
  "version-semver": "0.1.0",
  "supports": "windows & x64",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swscale"
      ],
      "version>=": "8.1.2"
    },
    "gtest",
    "nlohmann-json",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "network",
        "testlib",
        "windeployqt"
      ],
      "version>=": "6.11.1"
    },
    {
      "name": "qtdeclarative",
      "version>=": "6.11.1"
    },
    {
      "name": "qtshadertools",
      "version>=": "6.11.1"
    }
  ],
  "overrides": [
    {
      "name": "ffmpeg",
      "version": "8.1.2",
      "port-version": 3
    },
    {
      "name": "qtbase",
      "version": "6.11.1"
    },
    {
      "name": "qtdeclarative",
      "version": "6.11.1"
    },
    {
      "name": "qtshadertools",
      "version": "6.11.1"
    }
  ]
}
