root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,qml}]
indent_size = 4

[*.ps1]
indent_size = 4
end_of_line = crlf

[*.cmake]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[**/CMakeLists.txt]
indent_size = 4

[*.{json,jsonc,yaml,yml}]
indent_size = 2

[.clang-format]
indent_size = 2

[.clang-tidy]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
