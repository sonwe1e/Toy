{
  "version": 10,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "v143",
        "strategy": "external"
      },
      "cacheVariables": {
        "BUILD_TESTING": true,
        "CMAKE_AR": {
          "type": "FILEPATH",
          "value": "$env{VCToolsInstallDir}/bin/Host$env{VSCMD_ARG_HOST_ARCH}/$env{VSCMD_ARG_TGT_ARCH}/lib.exe"
        },
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg",
        "VCPKG_MANIFEST_INSTALL": true,
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "environment": {
        "VCPKG_FEATURE_FLAGS": "manifests,versions,binarycaching"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug development build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DVS_ENABLE_ASAN": false,
        "DVS_ENABLE_COVERAGE": false
      }
    },
    {
      "name": "dev-coverage",
      "displayName": "Debug coverage build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DVS_ENABLE_ASAN": false,
        "DVS_ENABLE_COVERAGE": true
      }
    },
    {
      "name": "asan",
      "displayName": "Debug AddressSanitizer build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DVS_ENABLE_ASAN": true,
        "DVS_ENABLE_COVERAGE": false
      }
    },
    {
      "name": "release",
      "displayName": "Release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DVS_ENABLE_ASAN": false,
        "DVS_ENABLE_COVERAGE": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-coverage",
      "configurePreset": "dev-coverage"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "filter": {
        "exclude": {
          "label": "^(hardware|performance|packaged|soak)$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-coverage",
      "inherits": "dev",
      "configurePreset": "dev-coverage"
    },
    {
      "name": "asan",
      "inherits": "dev",
      "configurePreset": "asan"
    },
    {
      "name": "release",
      "inherits": "dev",
      "configurePreset": "release"
    },
    {
      "name": "hardware-d3d11",
      "configurePreset": "release",
      "filter": {
        "include": {
          "label": "^hardware$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "performance-d3d11",
      "configurePreset": "release",
      "filter": {
        "include": {
          "label": "^performance$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "packaged-smoke",
      "configurePreset": "release",
      "filter": {
        "include": {
          "label": "^packaged$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "shutdown-soak",
      "configurePreset": "release",
      "filter": {
        "include": {
          "label": "^soak$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "packagePresets": [
    {
      "name": "release-zip",
      "configurePreset": "release",
      "generators": [
        "ZIP"
      ],
      "packageDirectory": "${sourceDir}/out/package/zip"
    },
    {
      "name": "release-msi",
      "configurePreset": "release",
      "generators": [
        "WIX"
      ],
      "packageDirectory": "${sourceDir}/out/package/msi"
    }
  ]
}
